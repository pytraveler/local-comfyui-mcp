# comfyui-mcp configuration.
# Copy to .env and adjust for your machine:  Copy-Item .env.example .env
#
# Precedence: the real process environment -> .env -> the defaults in config.py.
# An empty value means "use the default".
#
# The .env is looked for at $COMFYUI_MCP_ENV_FILE, then the repository root, then cwd.
#
# There is a Russian copy of this file beside it, .env.example.ru; install.bat
# seeds .env from whichever matches COMFYUI_LANG.

# --- Language -------------------------------------------------------------------
# What language the settings windows and the installer speak: en, ru, or empty for
# the machine's own. Only the half a person reads - the tool descriptions the model
# is given are English whatever this says, because they describe an interface to a
# program rather than talk to anybody.
COMFYUI_LANG=

# --- Connection -----------------------------------------------------------------
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# Basic Auth, for a ComfyUI reached through a reverse proxy that asks for it.
# Both or neither: one alone sends no credentials at all, and comfy_status says so.
# Empty is the localhost case and changes nothing. The password lives here rather
# than in the URL, where it would show up in process lists, logs and error text.
# Editing this file needs the server *process* restarted - a client reconnect does
# not re-read it.
COMFYUI_USER=
COMFYUI_PASSWORD=

# --- Paths ----------------------------------------------------------------------
# The root of the portable build: the folder holding ComfyUI\ and run_nvidia_gpu.bat.
COMFYUI_ROOT=V:\Programs\Comfy\Comfyui_portable

# The script inside COMFYUI_ROOT that starts ComfyUI (the comfy_start tool).
# .bat, .cmd, .ps1 or .sh - a .ps1 is run through PowerShell with -ExecutionPolicy
# Bypass, which applies to that one process and changes nothing on the machine.
# It has to be a file inside COMFYUI_ROOT: a path leading out of it is refused.
COMFYUI_LAUNCH_SCRIPT=run_nvidia_gpu.bat

# Where the API-format workflow files live. Defaults to workflows\ in the repository.
COMFYUI_WORKFLOWS_DIR=

# --- Timeouts, seconds ----------------------------------------------------------
# An ordinary HTTP request to ComfyUI.
COMFYUI_REQUEST_TIMEOUT=60

# /object_info returns the schema of every installed node - slow on a large install.
COMFYUI_OBJECT_INFO_TIMEOUT=120

# How long to wait for the API after comfy_start (custom nodes are loading).
COMFYUI_STARTUP_TIMEOUT=180

# The default timeout for run_workflow. Video workflows can run long.
COMFYUI_RUN_TIMEOUT=900

# The pause between /history polls when the WebSocket is unavailable.
COMFYUI_POLL_INTERVAL=1.0

# The pause between readiness checks while ComfyUI is starting.
COMFYUI_STARTUP_POLL_INTERVAL=2.0

# How long to wait for the process to end after taskkill, before killing it hard.
COMFYUI_STOP_GRACE=20

# How long to wait for a WebSocket message before reconciling against /history.
COMFYUI_WS_RECV_TIMEOUT=30

# The ping interval for the WebSocket connection.
COMFYUI_WS_PING_INTERVAL=20

# --- The workspace bridge -------------------------------------------------------
# Needs the comfy_node/comfyui_mcp_bridge node in ComfyUI and an open browser tab.
# Without them the workspace_* tools say which is missing; everything else is unaffected.

# How long to wait for the tab to answer. Reaching the live graph takes a fraction of
# a second, so a timeout here almost always means the tab is busy or closed.
COMFYUI_BRIDGE_TIMEOUT=20

# A shared secret for /mcp_bridge/call. Empty means no check, which is enough for
# localhost given that ComfyUI's own API has no authentication either. If it is set,
# the same value must be in COMFYUI_MCP_BRIDGE_TOKEN in ComfyUI's environment.
COMFYUI_BRIDGE_TOKEN=

# --- Which tools are offered ----------------------------------------------------
# A comma-separated list of groups or individual tools; a leading minus switches one
# off. A tool name beats a group name whatever the order they are written in.
#
#   all                                    everything (the default)
#   -download,-process                     everything except those two groups
#   status,workflows,run                   only these
#   workspace,-remove_workspace_nodes      a group, less one tool
#
# The groups: status (always on), workflows, logs, workspace, edit, run, download,
# process. A disabled tool is not registered at all - its schema never reaches the
# model, which is half the point. What is switched off shows in comfy_status. Edit
# this by hand or through the configure.bat window; either way the MCP server has to
# be restarted afterwards.
#
# This is not a security boundary: a checkbox answers "do I want this capability at
# all", not "what is allowed inside it". The settings below answer the second.
COMFYUI_TOOLS=all

# --- Downloading models ---------------------------------------------------------
# Where a file goes is ComfyUI's decision, not this server's: the folder list comes
# from it and accounts for extra_model_paths.yaml. Only the fetching is set here.

# How many seconds to wait for the next chunk of bytes. This detects a dead
# connection rather than bounding the download: a 5 GB file takes as long as it
# takes, but a channel silent for longer than this is dropped and retried, resuming.
COMFYUI_DOWNLOAD_TIMEOUT=60

# How many times to retry after a network failure. Each attempt continues where the
# last one stopped; the pause between them doubles up to 30 s.
COMFYUI_DOWNLOAD_RETRIES=5

# A token for private and gated repositories (HuggingFace, Civitai). It is sent only
# to the host the chain started at: a CDN link is already signed, and a stray
# Authorization header on it earns a 400. A shell environment variable does not reach
# the server - the value has to be here or in the client config's env block.
COMFYUI_DOWNLOAD_TOKEN=

# Hosts a model may be fetched from. Comma-separated; subdomains count, so
# huggingface.co also covers cdn-lfs.huggingface.co. Empty means no restriction.
#
# This is the narrowest point of the one chain that runs from somebody else's
# document to code executing on this machine: a URL from a note or from
# properties.models in a downloaded workflow reaches the model's context as ordinary
# text, and the model has a downloader. A URL suggested that way can name anything;
# it cannot name a host that is not in this list.
#
# Only the origin host is checked. Redirects are not, and cannot usefully be: a Hub
# link answers with a signed CDN host whose name varies (cdn-lfs.hf.co,
# cdn-lfs-us-1.hf.co, ...). The hosts the chain passed through are reported instead.
COMFYUI_DOWNLOAD_ALLOW_HOSTS=huggingface.co,hf.co,civitai.com,github.com,githubusercontent.com

# Allow formats that execute code as they load: .ckpt .pt .pt2 .pth .bin .pkl are
# pickle. .safetensors, .sft and .gguf are data, which is exactly what the first of
# them was invented for. Recent ComfyUI reads weights with weights_only=True, but
# custom nodes call torch.load themselves all the time. true/false.
COMFYUI_DOWNLOAD_ALLOW_PICKLE=false

# A ceiling on the size of one file, in gigabytes. 0 means no ceiling, and that is
# the sensible default: the free-space check already stops the volume filling, and
# real models run to 50 GB. Set it if you want a limit below the size of the disk.
COMFYUI_DOWNLOAD_MAX_GB=0

# --- Limits ---------------------------------------------------------------------
# The ceiling for a random seed when max could not be read from /object_info.
COMFYUI_FALLBACK_SEED_MAX=2147483647

# The long edge an image is scaled down to in show_image.
COMFYUI_PREVIEW_MAX_EDGE=1024

# The long edge of a canvas snapshot in screenshot_workspace. Larger means readable
# node labels and a costlier answer; no value fits a whole graph legibly, which is
# what fit=[...] over the nodes that matter is for.
COMFYUI_SCREENSHOT_MAX_EDGE=1400

# How many entries find_node_types and list_models return by default.
COMFYUI_NODE_LIST_LIMIT=60
COMFYUI_MODEL_LIST_LIMIT=100

# How many trailing console lines get_comfy_log returns by default. ComfyUI itself
# keeps only the last 300 records (hardcoded in app/logger.py, with no setting behind
# it), so nothing above that is available anyway.
COMFYUI_LOG_TAIL_LINES=200

# A ceiling on the size of a get_workspace_graph report, in characters. A live
# workflow is routinely larger than one answer holds: 140 nodes measured at 81.6 KB.
# A report that does not fit is stepped down a level (full -> links -> outline) and
# says so in the `reduced` field.
COMFYUI_GRAPH_MAX_CHARS=40000

# Where save_workspace writes a UI export. Deliberately apart from workflows/:
# list_workflows walks that tree recursively and reports anything that is not API
# format as an error. An API export goes to workflows/ instead - that one is runnable.
COMFYUI_EXPORT_DIR=exports

# --- Behaviour ------------------------------------------------------------------
# Unload models from VRAM before a run that needs a different set from the last one -
# but only when memory is already short. Low free VRAM is not a problem by itself:
# ComfyUI keeps models as a cache, which is exactly why a repeat run takes seconds.
# true/false.
COMFYUI_FREE_ON_SWITCH=true

# The fraction of free VRAM below which switching model sets is treated as risky.
# 0.2 means unload only when less than 20% is free.
COMFYUI_FREE_VRAM_MIN_FRACTION=0.2
