# Конфигурация comfyui-mcp.
# Скопируйте в .env и поправьте под свою машину:  Copy-Item .env.example.ru .env
#
# Порядок приоритета: реальное окружение процесса -> .env -> значения по умолчанию
# в config.py. Пустое значение = взять значение по умолчанию.
#
# Путь к .env ищется так: $COMFYUI_MCP_ENV_FILE, затем корень репозитория, затем cwd.
#
# Рядом лежит английская копия этого файла, .env.example; install.bat создаёт .env
# из той, которая отвечает COMFYUI_LANG.

# --- Язык -----------------------------------------------------------------------
# На каком языке говорят окна настройки и установщик: en, ru или пусто - тогда язык
# берётся у системы. Только та половина, которую читает человек: описания
# инструментов, которые получает модель, остаются английскими при любом значении,
# потому что они описывают интерфейс программы, а не обращаются к кому-то.
COMFYUI_LANG=

# --- Подключение --------------------------------------------------------------
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# --- Пути ---------------------------------------------------------------------
# Корень portable-сборки: та папка, где лежат ComfyUI\ и run_nvidia_gpu.bat.
COMFYUI_ROOT=V:\Programs\Comfy\Comfyui_portable

# .bat внутри COMFYUI_ROOT, которым запускается ComfyUI (инструмент comfy_start).
COMFYUI_LAUNCH_SCRIPT=run_nvidia_gpu.bat

# Где лежат workflow-файлы в API-формате. По умолчанию - workflows\ в репозитории.
COMFYUI_WORKFLOWS_DIR=

# --- Таймауты, секунды --------------------------------------------------------
# Обычный HTTP-запрос к ComfyUI.
COMFYUI_REQUEST_TIMEOUT=60

# /object_info отдаёт схемы всех установленных нод - на больших сборках это долго.
COMFYUI_OBJECT_INFO_TIMEOUT=120

# Сколько ждать готовности API после comfy_start (загрузка кастомных нод).
COMFYUI_STARTUP_TIMEOUT=180

# Значение timeout по умолчанию для run_workflow. Видео-workflow бывают долгими.
COMFYUI_RUN_TIMEOUT=900

# Пауза между опросами /history, когда WebSocket недоступен.
COMFYUI_POLL_INTERVAL=1.0

# Пауза между проверками готовности при запуске ComfyUI.
COMFYUI_STARTUP_POLL_INTERVAL=2.0

# Сколько ждать завершения процесса после taskkill, прежде чем убивать жёстко.
COMFYUI_STOP_GRACE=20

# Пауза в ожидании сообщения WebSocket, после которой состояние сверяется с /history.
COMFYUI_WS_RECV_TIMEOUT=30

# Интервал ping для WebSocket-соединения.
COMFYUI_WS_PING_INTERVAL=20

# --- Мост в рабочее пространство ----------------------------------------------
# Требует ноду comfy_node/comfyui_mcp_bridge в ComfyUI и открытой вкладки браузера.
# Без них инструменты workspace_* сообщают, чего не хватает; остальные работают как прежде.

# Сколько ждать ответа от вкладки. Обращение к живому графу - это доли секунды,
# так что срабатывание таймаута почти всегда означает, что вкладка занята или закрыта.
COMFYUI_BRIDGE_TIMEOUT=20

# Общий секрет для /mcp_bridge/call. Пусто - проверки нет; для localhost этого
# достаточно, поскольку собственный API ComfyUI тоже без аутентификации. Если
# задан, то же значение должно лежать в COMFYUI_MCP_BRIDGE_TOKEN в окружении ComfyUI.
COMFYUI_BRIDGE_TOKEN=

# --- Какие инструменты предлагать ----------------------------------------------
# Список групп или отдельных инструментов через запятую; минус впереди выключает.
# Имя инструмента сильнее имени группы, в каком бы порядке они ни стояли.
#
#   all                                    всё (по умолчанию)
#   -download,-process                     всё, кроме этих двух групп
#   status,workflows,run                   только эти
#   workspace,-remove_workspace_nodes      группа минус один инструмент
#
# Группы: status (всегда включена), workflows, logs, workspace, edit, run,
# download, process. Выключенный инструмент не регистрируется вовсе - его схема
# не попадает в контекст модели, и в этом половина смысла. Что именно выключено,
# видно в comfy_status. Правится вручную или окном configure.bat; и в том, и в
# другом случае нужен перезапуск MCP-сервера.
#
# Это не граница безопасности: галочка отвечает на вопрос "нужна ли мне вообще
# такая возможность", а не "что внутри неё допустимо". На второй отвечают
# настройки ниже.
COMFYUI_TOOLS=all

# --- Загрузка моделей ---------------------------------------------------------
# Куда класть файл, решает не этот сервер, а сам ComfyUI: список папок берётся у
# него и учитывает extra_model_paths.yaml. Здесь только то, как их качать.

# Сколько секунд ждать очередную порцию байт. Это детектор зависшего соединения,
# а не общий срок загрузки: файл на 5 ГБ качается сколько нужно, но канал,
# молчащий дольше этого, обрывается и попытка начинается заново с докачки.
COMFYUI_DOWNLOAD_TIMEOUT=60

# Сколько раз повторить попытку после сетевого сбоя. Каждая продолжает с того
# места, где остановилась предыдущая; пауза между ними растёт вдвое до 30 с.
COMFYUI_DOWNLOAD_RETRIES=5

# Токен для закрытых и gated-репозиториев (HuggingFace, Civitai). Уходит только
# на тот хост, с которого начали: ссылка на CDN уже подписана, и лишний
# Authorization на ней даёт 400. Переменная окружения оболочки до сервера не
# доходит - значение должно лежать здесь или в env-блоке клиентского конфига.
COMFYUI_DOWNLOAD_TOKEN=

# Хосты, с которых разрешено качать. Через запятую; поддомены входят, так что
# huggingface.co покрывает и cdn-lfs.huggingface.co. Пусто = без ограничения.
#
# Это самое узкое место единственной цепочки, ведущей от чужого документа к
# выполнению кода на этой машине: ссылка из заметки или из properties.models
# скачанного воркфлоу попадает модели в контекст как обычный текст, а загрузчик
# у неё есть. Подсказанная таким образом ссылка может назвать любой URL, но не
# может назвать хост, которого нет в этом списке.
#
# Проверяется только исходный хост. Редиректы - нет и не могут: ссылка с Hub
# отвечает подписанным CDN-хостом, имя которого меняется (cdn-lfs.hf.co,
# cdn-lfs-us-1.hf.co, ...). Через какие хосты прошла цепочка, видно в ответе.
COMFYUI_DOWNLOAD_ALLOW_HOSTS=huggingface.co,hf.co,civitai.com,github.com,githubusercontent.com

# Разрешить форматы, которые при загрузке выполняют код: .ckpt .pt .pt2 .pth
# .bin .pkl - это pickle. .safetensors, .sft и .gguf - данные, и придуман первый
# из них ровно поэтому. Свежая ComfyUI читает веса с weights_only=True, но
# кастомные ноды сплошь и рядом зовут torch.load сами. true/false.
COMFYUI_DOWNLOAD_ALLOW_PICKLE=false

# Потолок размера одного файла в гигабайтах. 0 = без потолка, и это разумное
# значение по умолчанию: том от переполнения защищает проверка свободного места,
# а настоящие модели бывают и на 50 ГБ. Ставьте, если хотите предел ниже размера
# диска.
COMFYUI_DOWNLOAD_MAX_GB=0

# --- Лимиты -------------------------------------------------------------------
# Предел случайного сида, если у ноды не удалось прочитать max из /object_info.
COMFYUI_FALLBACK_SEED_MAX=2147483647

# До какого размера по длинной стороне уменьшать картинку в show_image.
COMFYUI_PREVIEW_MAX_EDGE=1024

# Длинная сторона снимка холста в screenshot_workspace. Больше - читаемее
# подписи нод, но дороже по контексту; весь граф целиком не прочитать ни при
# каком значении, для этого есть fit=[...] по нужным нодам.
COMFYUI_SCREENSHOT_MAX_EDGE=1400

# Сколько записей возвращают find_node_types и list_models по умолчанию.
COMFYUI_NODE_LIST_LIMIT=60
COMFYUI_MODEL_LIST_LIMIT=100

# Сколько последних строк консоли отдаёт get_comfy_log по умолчанию. Сам ComfyUI
# хранит только последние 300 записей (жёстко зашито в app/logger.py, ключа нет),
# так что больше этого всё равно не будет.
COMFYUI_LOG_TAIL_LINES=200

# Потолок размера отчёта get_workspace_graph в символах. Живой воркфлоу бывает
# сильно больше, чем помещается в один ответ: замеряно 140 нод = 81.6 КБ. Отчёт,
# который в потолок не влез, огрубляется на ступень (full -> links -> outline) и
# сообщает об этом в поле `reduced`.
COMFYUI_GRAPH_MAX_CHARS=40000

# Куда save_workspace пишет UI-экспорт. Отдельно от workflows/ намеренно:
# list_workflows обходит ту папку рекурсивно и считает ошибкой всё, что не в
# API-формате. API-экспорт, наоборот, кладётся в workflows/ - его можно запускать.
COMFYUI_EXPORT_DIR=exports

# --- Поведение ----------------------------------------------------------------
# Выгружать модели из VRAM перед запуском, которому нужен другой набор моделей,
# чем предыдущему - но только если памяти уже мало. Низкий уровень свободной VRAM
# сам по себе нормален: ComfyUI держит модели как кэш, и именно поэтому повторный
# прогон занимает секунды. true/false.
COMFYUI_FREE_ON_SWITCH=true

# Доля свободной VRAM, ниже которой смена набора моделей считается опасной.
# 0.2 = выгружать, только если свободно меньше 20%.
COMFYUI_FREE_VRAM_MIN_FRACTION=0.2
